{
  "name": "nestjs-backend-server",
  "version": "1.0.0",
  "description": "Primary Reusable NestJS Backend Starter Template with Prisma 7, Better Auth, GraphQL, REST, and Centralized Infrastructure",
  "author": "James Dragon",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema=prisma/schema",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema=prisma/schema",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy --schema=prisma/schema",
    "prisma:studio": "dotenv -e .env -- prisma studio --schema=prisma/schema",
    "prisma:push": "dotenv -e .env -- prisma db push --schema=prisma/schema",
    "prisma:seed": "dotenv -e .env -- ts-node src/app/config/seed.ts",
    "db:setup": "dotenv -e .env -- prisma generate --schema=prisma/schema && dotenv -e .env -- prisma db push --schema=prisma/schema && dotenv -e .env -- ts-node src/app/config/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.2.6",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  }
}
